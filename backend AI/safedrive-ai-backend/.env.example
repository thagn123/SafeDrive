# SafeDrive AI Backend - Environment Configuration Example

# Runtime Environment (production, development, test)
ENVIRONMENT=production

# SafeDrive Capability Profile (PRODUCTION_NO_DMS, DMS_DEMO)
ACTIVE_PROFILE=PRODUCTION_NO_DMS

# SafeDrive API Key Boundary (Required when ENVIRONMENT=production)
SAFEDRIVE_API_KEY=change_this_to_a_secure_api_key_in_production

# Path to Signal Registry Config
SIGNAL_REGISTRY_PATH=configs/signal_registry.yaml

# Network Settings
HOST=0.0.0.0
PORT=8000

# Logging & Provider Boundaries
LOG_LEVEL=INFO
LLM_PROVIDER=mock
# Optional local companion narration. This never controls safety, SOS or vehicle actions.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_TIMEOUT_SECONDS=20
# LLM_API_KEY=optional_cloud_llm_api_key_placeholder
